+    /* 24.  */
+    "$f24",  "$f25",  "$f26", "$f27",  "$f28",  "$f29",  "$f30",  "$f31",
+  };
+
+const char *
+unw_regname (unw_regnum_t reg)
+{
+  if (reg < (unw_regnum_t) ARRAY_SIZE (regname))
+    return regname[reg];
+  else if (reg == UNW_SW_64_PC)
+    return "pc";
+  else
