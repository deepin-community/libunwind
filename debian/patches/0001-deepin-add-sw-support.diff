+#define tdep_get_exe_image_path         UNW_ARCH_OBJ(get_exe_image_path)
+#define tdep_access_reg                        UNW_OBJ(access_reg)
+#define tdep_access_fpreg              UNW_OBJ(access_fpreg)
+#define tdep_fetch_frame(c,ip,n)       do {} while(0)
