+
+#include "unwind_i.h"
+#include "dwarf_i.h"
+
+HIDDEN define_lock (sw_64_lock);
+HIDDEN int tdep_init_done;
+
+HIDDEN void
+tdep_init (void)
+{
+  intrmask_t saved_mask;
+
+  sigfillset (&unwi_full_mask);
+  sigdelset(&unwi_full_mask, 5);     /* LIJM */
+
+  lock_acquire (&sw_64_lock, saved_mask);
+  {
+    if (tdep_init_done)
+      /* another thread else beat us to it... */
+      goto out;
+
+    mi_init ();
+
+    dwarf_init ();
+
+#ifndef UNW_REMOTE_ONLY
+    sw_64_local_addr_space_init ();
+#endif
+    tdep_init_done = 1; /* signal that we're initialized... */
+  }
+ out:
+  lock_release (&sw_64_lock, saved_mask);
+}

